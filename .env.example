# WordPress MCP Configuration

# Adapter Mode: 'cli' or 'rest'
WP_ADAPTER=cli

# Safe Mode: Set to 'false' to allow write operations (create/update/delete). Default is 'true'
SAFE_MODE=true

# Optional Audit Log File Path
# AUDIT_LOG_PATH=/path/to/wordpress-mcp-audit.log

# -------------------------------------------------------------
# Mode A: WP-CLI / LocalWP Configuration (when WP_ADAPTER=cli)
# -------------------------------------------------------------
# Path to the WordPress root directory (folder containing wp-config.php or LocalWP site root)
WP_PATH=/Volumes/T7/Other local/wptest

# Optional path to localwp-cli.sh helper script (auto-detected if installed)
# LOCALWP_SCRIPT_PATH=/Users/username/.gemini/config/skills/localwp-cli-skill/scripts/localwp-cli.sh

# -------------------------------------------------------------
# Mode B: Remote REST API Configuration (when WP_ADAPTER=rest)
# -------------------------------------------------------------
# Full URL to your WordPress site
WP_SITE_URL=https://example.com

# WordPress username
WP_USERNAME=admin

# WordPress Application Password (generated under Users -> Profile -> Application Passwords)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx
